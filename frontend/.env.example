# Quizora Frontend Environment Configuration
VITE_APP_NAME=Quizora

# Production Backend URLs (Deploy backend to Render / Railway / Cloud)
# When set, the frontend will communicate directly with your deployed backend:
# VITE_API_BASE_URL=https://quizora-backend.onrender.com/api
# VITE_WS_BASE_URL=wss://quizora-backend.onrender.com/ws-raw

# Local Development:
# Leave VITE_API_BASE_URL blank in .env.local to use the built-in Vite proxy (/api and /ws-raw)
